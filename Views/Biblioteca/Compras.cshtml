@model IReadOnlyList<Compra>
@{
    ViewData["Title"] = "Mis compras";
    var buscar = ViewBag.Buscar as string ?? string.Empty;
    var pagina = (int)(ViewBag.Pagina ?? 1);
    var totalPaginas = (int)(ViewBag.TotalPaginas ?? 1);
}
<div class="management-page"><div class="management-container">
    <header class="management-header"><span class="library-small-title">TU BIBLIOTECA PERSONAL</span><h1>Mis compras</h1><p>Los libros que compraste están acá. La descarga solo está disponible mientras la compra no haya sido devuelta.</p></header>
    <div class="library-filters"><a asp-action="Compras" class="library-filter active">Compras</a><a asp-action="Alquileres" class="library-filter">Alquileres</a></div>
    <form method="get" asp-action="Compras" class="admin-search-form"><input class="form-control" type="search" name="buscar" value="@buscar" maxlength="150" placeholder="Buscar por título o autor..." aria-label="Buscar compras" /><button class="detail-secondary-button" type="submit">Buscar</button>@if (!string.IsNullOrWhiteSpace(buscar)) { <a asp-action="Compras" class="detail-secondary-button">Limpiar</a> }</form>
    @if (Model.Count == 0)
    {
        <div class="management-card empty-state">
            @if (!string.IsNullOrWhiteSpace(buscar)) { <h2>No encontramos compras con esa búsqueda</h2><p>Probá con otro título o autor.</p><a class="detail-secondary-button" asp-action="Compras">Limpiar búsqueda</a> }
            else { <h2>Todavía no compraste libros</h2><p>Explorá el catálogo para encontrar tu próxima lectura.</p><a class="detail-primary-button" asp-controller="Libros" asp-action="Index">Explorar catálogo</a> }
        </div>
    }
    else
    {
        <section class="management-card"><div class="table-responsive"><table class="table management-table align-middle"><thead><tr><th>Libro</th><th>Fecha</th><th>Importe</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
        @foreach (var compra in Model)
        {
            <tr><td><strong><a asp-controller="Libros" asp-action="Detalle" asp-route-id="@compra.IdLibro">@compra.Libro.Titulo</a></strong><small class="d-block text-muted">@(compra.Libro.Autor ?? "Autor no indicado")</small></td><td>@compra.FechaCompra.ToString("dd/MM/yyyy")</td><td>@compra.Importe.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</td><td>@if (compra.Devuelto) { <span class="status-pill status-muted">Devuelto</span> } else { <span class="status-pill status-success">Disponible</span> }</td><td><div class="row-actions">@if (!compra.Devuelto) { <a asp-controller="Libros" asp-action="Descargar" asp-route-id="@compra.IdLibro">Descargar</a> @if (DateTime.Now <= compra.FechaCompra.AddDays(7)) { <form asp-controller="Libros" asp-action="DevolverCompra" method="post" onsubmit="return confirm('¿Querés devolver esta compra? Vas a perder el acceso al archivo.');"><input type="hidden" name="id" value="@compra.Id" /><button type="submit">Devolver</button></form> } }</div><small class="d-block text-muted">@if (!compra.Devuelto && DateTime.Now <= compra.FechaCompra.AddDays(7)) { <text>Disponible para devolución hasta @compra.FechaCompra.AddDays(7).ToString("dd/MM/yyyy")</text> }</small></td></tr>
        }
        </tbody></table></div>
        @if (totalPaginas > 1) { <nav class="library-pagination" aria-label="Paginación de compras">@if (pagina > 1) { <a asp-route-buscar="@buscar" asp-route-pagina="@(pagina - 1)">← Anterior</a> }<span>Página @pagina de @totalPaginas</span>@if (pagina < totalPaginas) { <a asp-route-buscar="@buscar" asp-route-pagina="@(pagina + 1)">Siguiente →</a> }</nav> }
        </section>
    }
</div></div>
