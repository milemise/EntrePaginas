@model IReadOnlyList<Alquiler>
@{
    ViewData["Title"] = "Mis alquileres";
    var buscar = ViewBag.Buscar as string ?? string.Empty;
    var pagina = (int)(ViewBag.Pagina ?? 1);
    var totalPaginas = (int)(ViewBag.TotalPaginas ?? 1);
}
<div class="management-page"><div class="management-container">
    <header class="management-header"><span class="library-small-title">TU BIBLIOTECA PERSONAL</span><h1>Mis alquileres</h1><p>Los alquileres dan acceso a lectura online hasta su fecha de vencimiento, pero no habilitan la descarga.</p></header>
    <div class="library-filters"><a asp-action="Compras" class="library-filter">Compras</a><a asp-action="Alquileres" class="library-filter active">Alquileres</a></div>
    <form method="get" asp-action="Alquileres" class="admin-search-form"><input class="form-control" type="search" name="buscar" value="@buscar" maxlength="150" placeholder="Buscar por título o autor..." aria-label="Buscar alquileres" /><button class="detail-secondary-button" type="submit">Buscar</button>@if (!string.IsNullOrWhiteSpace(buscar)) { <a asp-action="Alquileres" class="detail-secondary-button">Limpiar</a> }</form>
    @if (Model.Count == 0)
    {
        <div class="management-card empty-state">
            @if (!string.IsNullOrWhiteSpace(buscar)) { <h2>No encontramos alquileres con esa búsqueda</h2><p>Probá con otro título o autor.</p><a class="detail-secondary-button" asp-action="Alquileres">Limpiar búsqueda</a> }
            else { <h2>No tenés alquileres todavía</h2><p>Alquilá un libro para leerlo online durante el período elegido.</p><a class="detail-primary-button" asp-controller="Libros" asp-action="Index">Explorar catálogo</a> }
        </div>
    }
    else
    {
        <section class="management-card"><div class="table-responsive"><table class="table management-table align-middle"><thead><tr><th>Libro</th><th>Inicio</th><th>Vencimiento</th><th>Importe</th><th>Estado</th><th></th></tr></thead><tbody>
        @foreach (var alquiler in Model)
        {
            var vigente = alquiler.Activo && alquiler.FechaInicio <= DateTime.Now && alquiler.FechaHasta >= DateTime.Now;
            <tr><td><strong><a asp-controller="Libros" asp-action="Detalle" asp-route-id="@alquiler.IdLibro">@alquiler.Libro.Titulo</a></strong><small class="d-block text-muted">@(alquiler.Libro.Autor ?? "Autor no indicado")</small></td><td>@alquiler.FechaInicio.ToString("dd/MM/yyyy")</td><td>@alquiler.FechaHasta.ToString("dd/MM/yyyy")</td><td>@alquiler.Importe.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</td><td>@if (vigente) { <span class="status-pill status-success">Vigente</span> } else { <span class="status-pill status-muted">Vencido</span> }</td><td>@if (vigente) { <a class="detail-secondary-button" asp-controller="Libros" asp-action="Leer" asp-route-id="@alquiler.IdLibro">Leer online</a> }</td></tr>
        }
        </tbody></table></div>
        @if (totalPaginas > 1) { <nav class="library-pagination" aria-label="Paginación de alquileres">@if (pagina > 1) { <a asp-route-buscar="@buscar" asp-route-pagina="@(pagina - 1)">← Anterior</a> }<span>Página @pagina de @totalPaginas</span>@if (pagina < totalPaginas) { <a asp-route-buscar="@buscar" asp-route-pagina="@(pagina + 1)">Siguiente →</a> }</nav> }
        </section>
    }
</div></div>
