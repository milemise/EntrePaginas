@model LibroListadoViewModel
@{
    ViewData["Title"] = "Catálogo";
    string UrlConPagina(int pagina) => Url.Action("Index", new { buscar = Model.Buscar, categoriaId = Model.CategoriaId, ordenar = Model.Ordenar, pagina }) ?? "#";
}
<div class="library-page">
    <div class="library-container">
        <div class="library-header">
            <span class="library-small-title">BIBLIOTECA DIGITAL</span>
            <h1>Un mundo entre páginas</h1>
            <p>Buscá tu próxima lectura entre las historias disponibles.</p>
        </div>
        <form class="library-search" method="get" asp-controller="Libros" asp-action="Index">
            <div class="library-search-input"><span>⌕</span><input type="search" name="buscar" value="@Model.Buscar" placeholder="Buscar por título, autor o descripción..." aria-label="Buscar libros" /></div>
            <button type="submit" class="library-search-button">Buscar</button>
        </form>
        <div class="library-filters">
            <a class="library-filter @(Model.CategoriaId == null ? "active" : "")" asp-action="Index" asp-route-buscar="@Model.Buscar" asp-route-ordenar="@Model.Ordenar">Todos</a>
            @foreach (var categoria in Model.Categorias)
            {
                <a class="library-filter @(Model.CategoriaId == categoria.Id ? "active" : "")" asp-action="Index" asp-route-buscar="@Model.Buscar" asp-route-categoriaId="@categoria.Id" asp-route-ordenar="@Model.Ordenar">@categoria.Nombre</a>
            }
        </div>
        <div class="library-results">
            <span>@Model.TotalRegistros libros encontrados</span>
            <form method="get" asp-action="Index" class="library-order-form">
                <input type="hidden" name="buscar" value="@Model.Buscar" />
                <input type="hidden" name="categoriaId" value="@Model.CategoriaId" />
                <select class="library-order" name="ordenar" onchange="this.form.submit()" aria-label="Ordenar libros">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.Ordenar))">Orden alfabético</option>
                    <option value="recientes" selected="@(Model.Ordenar == "recientes")">Más recientes</option>
                    <option value="precio-menor" selected="@(Model.Ordenar == "precio-menor")">Precio menor</option>
                    <option value="precio-mayor" selected="@(Model.Ordenar == "precio-mayor")">Precio mayor</option>
                    <option value="puntuacion" selected="@(Model.Ordenar == "puntuacion")">Mejor puntuados</option>
                </select>
            </form>
        </div>
        @if (Model.Libros.Count == 0)
        {
            <div class="empty-state"><h2>No encontramos libros con esa búsqueda</h2><p>Probá con otro título, autor o género.</p><a asp-action="Index" class="book-button">Limpiar filtros</a></div>
        }
        else
        {
            <div class="library-grid">
                @foreach (var libro in Model.Libros)
                {
                    var portada = string.IsNullOrWhiteSpace(libro.PortadaUrl) ? Url.Content("~/images/portada1.jpg") : (libro.PortadaUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ? libro.PortadaUrl : Url.Content("~/" + libro.PortadaUrl.TrimStart('/')));
                    Model.ResumenResenas.TryGetValue(libro.Id, out var resumen);
                    var promedio = resumen?.Promedio ?? 0;
                    var cantidadResenas = resumen?.Cantidad ?? 0;
                    <article class="library-book-card">
                        <a asp-action="Detalle" asp-route-id="@libro.Id" class="library-book-cover"><img src="@portada" alt="Portada de @libro.Titulo" loading="lazy" /></a>
                        <div class="library-book-content">
                            <span class="library-category">@libro.Categoria.Nombre</span>
                            <h2><a asp-action="Detalle" asp-route-id="@libro.Id">@libro.Titulo</a></h2>
                            <p class="library-author">por @(string.IsNullOrWhiteSpace(libro.Autor) ? $"{libro.Escritor.Nombre} {libro.Escritor.Apellido}" : libro.Autor)</p>
                            <p class="library-description">@(string.IsNullOrWhiteSpace(libro.Descripcion) ? "Una historia para descubrir." : libro.Descripcion)</p>
                            <div class="library-rating"><span class="stars">@(promedio == 0 ? "☆☆☆☆☆" : new string('★', (int)Math.Round(promedio)))</span><span>@(cantidadResenas == 0 ? "Sin reseñas" : promedio.ToString("0.0"))</span></div>
                            <div class="library-price"><span class="price-label">Comprar</span><strong>@libro.PrecioCompra.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</strong></div>
                            <a asp-action="Detalle" asp-route-id="@libro.Id" class="library-view-button">Ver libro</a>
                        </div>
                    </article>
                }
            </div>
            @if (Model.TotalPaginas > 1)
            {
                <nav class="library-pagination" aria-label="Paginación del catálogo">
                    @if (Model.Pagina > 1) { <a href="@UrlConPagina(Model.Pagina - 1)">← Anterior</a> }
                    @for (var p = Math.Max(1, Model.Pagina - 2); p <= Math.Min(Model.TotalPaginas, Model.Pagina + 2); p++)
                    {
                        <a href="@UrlConPagina(p)" class="@(p == Model.Pagina ? "active" : "")" aria-current="@(p == Model.Pagina ? "page" : null)">@p</a>
                    }
                    @if (Model.Pagina < Model.TotalPaginas) { <a href="@UrlConPagina(Model.Pagina + 1)">Siguiente →</a> }
                </nav>
            }
        }
    </div>
</div>
