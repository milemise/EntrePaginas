@model LibroDetalleViewModel
@{
    ViewData["Title"] = Model.Libro.Titulo;
    var libro = Model.Libro;
    var portada = string.IsNullOrWhiteSpace(libro.PortadaUrl) ? Url.Content("~/images/portada1.jpg") : (libro.PortadaUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ? libro.PortadaUrl : Url.Content("~/" + libro.PortadaUrl.TrimStart('/')));
    var promedio = Model.PromedioResenas;
}
<div class="detail-page">
    <div class="detail-container">
        <a asp-action="Index" class="detail-back">← Volver al catálogo</a>
        <div class="detail-grid">
            <div class="detail-cover-wrap"><img class="detail-cover" src="@portada" alt="Portada de @libro.Titulo" /><span class="detail-category">@libro.Categoria.Nombre</span></div>
            <section class="detail-info">
                @if (libro.EsMas18) { <span class="age-badge">+18</span> }
                <h1>@libro.Titulo</h1>
                <p class="detail-author">@(string.IsNullOrWhiteSpace(libro.Autor) ? $"Publicado por {libro.Escritor.Nombre} {libro.Escritor.Apellido}" : $"Por {libro.Autor}")</p>
                @if (Model.TotalResenas > 0)
                {
                    <p class="detail-rating"><span class="stars">@(new string('★', (int)Math.Round(promedio)))</span> @promedio.ToString("0.0") <span>· @Model.TotalResenas reseñas</span></p>
                }
                <div class="detail-description"><h2>Sobre este libro</h2><p>@(string.IsNullOrWhiteSpace(libro.Descripcion) ? "Todavía no hay una descripción disponible para esta obra." : libro.Descripcion)</p></div>
                @if (libro.LibroAnterior is not null)
                {
                    <p class="saga-link"><strong>Libro anterior:</strong> <a asp-action="Detalle" asp-route-id="@libro.LibroAnterior.Id">@libro.LibroAnterior.Titulo</a></p>
                }
                @if (libro.LibrosSiguientes.Count > 0)
                {
                    <div class="saga-link"><strong>Continúa en:</strong> @foreach (var siguiente in libro.LibrosSiguientes) { <a asp-action="Detalle" asp-route-id="@siguiente.Id">@siguiente.Titulo</a> }</div>
                }
                <div class="detail-price-grid">
                    <div class="detail-price-box"><span>Comprar</span><strong>@libro.PrecioCompra.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</strong><small>Descarga disponible después de la compra</small></div>
                    <div class="detail-price-box"><span>Alquilar</span><strong>@libro.PrecioAlquiler.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</strong><small>Lectura online por tiempo limitado</small></div>
                </div>
                @if (Model.ContenidoBloqueado)
                {
                    <div class="alert alert-warning mt-3">@Model.MotivoBloqueo</div>
                }
                else if (User.IsInRole("Lector"))
                {
                    <div class="detail-actions">
                        @if (Model.PuedeComprar)
                        {
                            <form asp-action="Comprar" method="post"><input type="hidden" name="id" value="@libro.Id" /><button class="detail-primary-button" type="submit">Comprar libro</button></form>
                        }
                        else if (Model.CompraVigente)
                        {
                            <a class="detail-primary-button" asp-controller="Biblioteca" asp-action="Compras">Ya está en mi biblioteca</a>
                        }
                        @if (Model.PuedeAlquilar)
                        {
                            <form asp-action="Alquilar" method="post" class="rent-form"><input type="hidden" name="id" value="@libro.Id" /><label for="dias">Duración</label><select name="dias" id="dias"><option value="7">7 días</option><option value="15">15 días</option><option value="30">30 días</option></select><button type="submit" class="detail-secondary-button">Alquilar</button></form>
                        }
                        @if (Model.AlquilerVigente)
                        {
                            <a class="detail-secondary-button" asp-action="Leer" asp-route-id="@libro.Id">Leer online</a>
                        }
                        @if (Model.CompraVigente)
                        {
                            <a class="detail-secondary-button" asp-action="Descargar" asp-route-id="@libro.Id">Descargar libro</a>
                        }
                    </div>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <p class="login-prompt"><a asp-controller="Cuenta" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Iniciá sesión</a> para comprar o alquilar este libro.</p>
                }
            </section>
        </div>
        <section class="reviews-section">
            <div class="reviews-heading"><h2>Opiniones de lectores</h2><span>@Model.TotalResenas reseñas</span></div>
            @if (Model.PuedeResenar && Model.MiResenaId is null)
            {
                <form asp-controller="Resenas" asp-action="Crear" method="post" class="review-form">
                    <input type="hidden" name="IdLibro" value="@libro.Id" />
                    <div class="review-form-top"><label for="Puntuacion">Tu puntuación</label><select name="Puntuacion" id="Puntuacion"><option value="5">5 — Excelente</option><option value="4">4 — Muy bueno</option><option value="3">3 — Bueno</option><option value="2">2 — Regular</option><option value="1">1 — No me gustó</option></select></div>
                    <label for="Comentario">Tu reseña</label><textarea id="Comentario" name="Comentario" rows="3" maxlength="3000" placeholder="¿Qué te pareció esta historia?"></textarea>
                    <label class="anonymous-check"><input type="checkbox" name="Anonimo" value="true" /> Publicar de forma anónima</label>
                    <button type="submit" class="detail-primary-button">Publicar reseña</button>
                </form>
            }
            else if (Model.MiResenaId is not null)
            {
                <p class="muted-note">Ya publicaste una reseña para este libro.</p>
            }
            @if (libro.Resenas.Count == 0)
            {
                <p class="muted-note">Todavía no hay opiniones. Cuando los lectores compartan su experiencia, aparecerá acá.</p>
            }
            else
            {
                <div class="review-list">
                    @foreach (var resena in libro.Resenas)
                    {
                        <article class="review-item">
                            <div class="review-item-heading"><strong>@(resena.Anonimo ? "Lector anónimo" : $"{resena.Lector.Nombre} {resena.Lector.Apellido}")</strong><span class="stars">@(new string('★', resena.Puntuacion))@(new string('☆', 5 - resena.Puntuacion))</span><time datetime="@resena.FechaComentario.ToString("yyyy-MM-dd")">@resena.FechaComentario.ToString("dd/MM/yyyy")</time></div>
                            @if (!string.IsNullOrWhiteSpace(resena.Comentario)) { <p>@resena.Comentario</p> }
                            @if (User.IsInRole("Escritor") && libro.IdEscritor == int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0"))
                            {
                                <div class="review-moderation"><form asp-controller="Resenas" asp-action="Reportar" method="post"><input type="hidden" name="id" value="@resena.Id" /><button type="submit" class="btn btn-sm btn-outline-secondary">Reportar a administración</button></form><form asp-controller="Resenas" asp-action="Eliminar" method="post" onsubmit="return confirm('¿Eliminar esta reseña?');"><input type="hidden" name="id" value="@resena.Id" /><button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button></form></div>
                            }
                        </article>
                    }
                </div>
                @if (Model.TotalPaginasResenas > 1)
                {
                    <nav class="library-pagination" aria-label="Paginación de reseñas">
                        @for (var p = 1; p <= Model.TotalPaginasResenas; p++) { <a asp-action="Detalle" asp-route-id="@libro.Id" asp-route-paginaResenas="@p" class="@(p == Model.PaginaResenas ? "active" : "")">@p</a> }
                    </nav>
                }
            }
        </section>
    </div>
</div>
