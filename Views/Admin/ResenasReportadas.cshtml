@model ResenasAdminViewModel
@{
    ViewData["Title"] = "Reseñas reportadas";
}
<div class="management-page"><div class="management-container">
    <a asp-action="Index" class="detail-back">← Panel de administración</a>
    <header class="management-header"><span class="library-small-title">MODERACIÓN</span><h1>Reseñas reportadas</h1><p>Los escritores pueden reportar reseñas asociadas a sus propios libros para que un administrador las revise.</p></header>
    <section class="management-card">
        @if (Model.Resenas.Count == 0)
        {
            <div class="empty-state"><h2>No hay reportes pendientes</h2><p>Cuando un escritor reporte una reseña, aparecerá en esta lista.</p></div>
        }
        else
        {
            <div class="reported-list">
            @foreach (var resena in Model.Resenas)
            {
                <article class="reported-review"><div class="review-item-heading"><strong>@resena.Libro.Titulo</strong><span class="stars">@(new string('★', resena.Puntuacion))@(new string('☆', 5-resena.Puntuacion))</span><time>@resena.FechaComentario.ToString("dd/MM/yyyy")</time></div><p class="text-muted">Publicado por: @(resena.Anonimo ? "Lector anónimo" : $"{resena.Lector.Nombre} {resena.Lector.Apellido}")</p><p>@(string.IsNullOrWhiteSpace(resena.Comentario) ? "(Sin comentario)" : resena.Comentario)</p><div class="row-actions"><form asp-controller="Resenas" asp-action="Eliminar" method="post" onsubmit="return confirm('¿Eliminar definitivamente esta reseña?');"><input type="hidden" name="id" value="@resena.Id" /><button type="submit" class="danger-action">Eliminar reseña</button></form><form asp-action="DesestimarReporte" method="post"><input type="hidden" name="id" value="@resena.Id" /><button type="submit">Desestimar reporte</button></form></div></article>
            }
            </div>
            @if (Model.TotalPaginas > 1) { <nav class="library-pagination">@if (Model.Pagina > 1) { <a asp-route-pagina="@(Model.Pagina-1)">← Anterior</a> }<span>Página @Model.Pagina de @Model.TotalPaginas</span>@if (Model.Pagina < Model.TotalPaginas) { <a asp-route-pagina="@(Model.Pagina+1)">Siguiente →</a> }</nav> }
        }
    </section>
</div></div>
