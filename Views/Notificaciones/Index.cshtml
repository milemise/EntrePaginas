
@model IEnumerable<EntrePaginas.Models.Notificacion>

@{
    ViewData["Title"] = "Mis notificaciones";

    var notificaciones = Model?.ToList()
        ?? new List<EntrePaginas.Models.Notificacion>();

    var cantidadNoLeidas = (int)(ViewBag.CantidadNoLeidas ?? 0);
    var totalNotificacionesUsuario = (int)(ViewBag.TotalNotificacionesUsuario ?? notificaciones.Count);
    var totalFiltrado = (int)(ViewBag.TotalFiltrado ?? notificaciones.Count);
    var paginaActual = (int)(ViewBag.Pagina ?? 1);
    var totalPaginas = (int)(ViewBag.TotalPaginas ?? 1);
    var busquedaActual = ViewBag.Buscar as string ?? string.Empty;
    var filtroActual = ViewBag.Filtro as string ?? "todas";
}

<link rel="stylesheet"
      href="~/css/notificaciones.css"
      asp-append-version="true" />

<main class="notificaciones-page">
    <section class="notificaciones-hero">
        <span class="notificaciones-eyebrow">
            EL CORREO DE ENTRE PÁGINAS
        </span>

        <h1>Tu rincón de novedades</h1>

        <p>
            Cada mensaje trae una historia.
            Acá encontrarás las novedades de tu mundo literario.
        </p>

        <div class="notificaciones-resumen">
            <span>
                <strong>@totalFiltrado</strong>
                @(totalFiltrado == 1
                    ? "resultado"
                    : "resultados")
            </span>

            <span class="resumen-separador">·</span>

            <span>
                <strong>@cantidadNoLeidas</strong>
                sin leer · @totalNotificacionesUsuario en total
            </span>
        </div>
    </section>

    @if (TempData["MensajeNotificacion"] is string mensaje)
    {
        <div class="notificaciones-alerta" role="status">
            @mensaje
        </div>
    }

    <section class="notificaciones-contenido">
        <div class="notificaciones-titulo">
            <div>
                <span class="notificaciones-eyebrow">
                    TU BANDEJA PERSONAL
                </span>
                <h2>Notificaciones</h2>
            </div>

            @if (cantidadNoLeidas > 0)
            {
                <form asp-controller="Notificaciones"
                      asp-action="MarcarTodasComoLeidas"
                      method="post">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn-notificacion-secundario">
                        ✓ Marcar todas como leídas
                    </button>
                </form>
            }
        </div>

        <form method="get" asp-controller="Notificaciones" asp-action="Index" class="notificaciones-buscador">
            <label class="visually-hidden" for="buscarNotificaciones">Buscar notificaciones</label>
            <input id="buscarNotificaciones" type="search" name="buscar" value="@busquedaActual" maxlength="150" placeholder="Buscar por título, mensaje o tipo..." />
            <select name="filtro" aria-label="Filtrar notificaciones">
                <option value="todas" selected="@(filtroActual == "todas")">Todas</option>
                <option value="no-leidas" selected="@(filtroActual == "no-leidas")">Sin leer</option>
                <option value="favoritas" selected="@(filtroActual == "favoritas")">Favoritas</option>
            </select>
            <button type="submit" class="btn-notificacion-secundario">Buscar</button>
            @if (!string.IsNullOrWhiteSpace(busquedaActual) || filtroActual != "todas")
            {
                <a asp-controller="Notificaciones" asp-action="Index" class="btn-notificacion-secundario">Limpiar</a>
            }
        </form>

        @if (!notificaciones.Any())
        {
            <div class="notificaciones-vacias">
                <span class="notificaciones-vacias-icono">✉</span>
                <h3>@(totalFiltrado == 0 && ( !string.IsNullOrWhiteSpace(busquedaActual) || filtroActual != "todas") ? "No encontramos notificaciones" : "Tu bandeja está tranquila")</h3>
                <p>
                    @if (!string.IsNullOrWhiteSpace(busquedaActual) || filtroActual != "todas")
                    {
                        <text>Probá con otra palabra o cambiá el filtro para ver otros mensajes.</text>
                    }
                    else
                    {
                        <text>Por ahora no tenés notificaciones. Cuando haya novedades, las encontrarás acá.</text>
                    }
                </p>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn-notificacion-principal">
                    Volver a explorar
                </a>
            </div>
        }
        else
        {
            <div class="notificaciones-lista">
                @foreach (var notificacion in notificaciones)
                {
                    var iconoTipo = notificacion.Tipo switch
                    {
                        "Compra" => "✓",
                        "Alquiler" => "◷",
                        "Venta" => "↗",
                        "Resena" => "✎",
                        "Reporte" => "⚑",
                        "Moderacion" => "⚖",
                        _ => "✉"
                    };

                    <article class="notificacion-card @(notificacion.Leida ? "leida" : "no-leida") @(notificacion.Favorita ? "es-favorita" : "")">
                        <div class="notificacion-icono">
                            <span aria-hidden="true">@iconoTipo</span>
                        </div>

                        <div class="notificacion-cuerpo">
                            <div class="notificacion-encabezado">
                                <h3>@notificacion.Titulo</h3>

                                @if (!notificacion.Leida)
                                {
                                    <span class="notificacion-nueva">
                                        Nueva
                                    </span>
                                }

                                @if (notificacion.Favorita)
                                {
                                    <span class="notificacion-favorita">
                                        ★ Favorita
                                    </span>
                                }
                            </div>

                            <p class="notificacion-mensaje">
                                @notificacion.Mensaje
                            </p>

                            <time class="notificacion-fecha"
                                  datetime="@notificacion.FechaCreacion.ToString("yyyy-MM-ddTHH:mm:ss")">
                                @notificacion.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                            </time>

                            <div class="notificacion-acciones">
                                @if (!string.IsNullOrWhiteSpace(notificacion.UrlDestino))
                                {
                                    <form asp-controller="Notificaciones"
                                          asp-action="Abrir"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@notificacion.Id" />

                                        <button type="submit"
                                                class="btn-notificacion-abrir">
                                            Ver notificación →
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Notificaciones"
                                          asp-action="MarcarComoLeida"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@notificacion.Id" />

                                        <button type="submit"
                                                class="btn-notificacion-abrir">
                                            Marcar como leída
                                        </button>
                                    </form>
                                }

                                <form asp-controller="Notificaciones"
                                      asp-action="AlternarFavorita"
                                      method="post">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@notificacion.Id" />

                                    <button type="submit"
                                            class="btn-notificacion-accion"
                                            title="@(notificacion.Favorita ? "Quitar de favoritos" : "Agregar a favoritos")">
                                        @(notificacion.Favorita ? "★" : "☆")
                                        <span>
                                            @(notificacion.Favorita
                                                ? "Quitar favorita"
                                                : "Guardar")
                                        </span>
                                    </button>
                                </form>

                                @if (notificacion.Leida)
                                {
                                    <form asp-controller="Notificaciones"
                                          asp-action="MarcarComoNoLeida"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@notificacion.Id" />

                                        <button type="submit"
                                                class="btn-notificacion-accion">
                                            Marcar como no leída
                                        </button>
                                    </form>
                                }

                                <form asp-controller="Notificaciones"
                                      asp-action="Eliminar"
                                      method="post"
                                      onsubmit="return confirm('¿Querés eliminar esta notificación?');">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@notificacion.Id" />

                                    <button type="submit"
                                            class="btn-notificacion-eliminar">
                                        Eliminar
                                    </button>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </div>
            @if (totalPaginas > 1)
            {
                <nav class="library-pagination" aria-label="Paginación de notificaciones">
                    @if (paginaActual > 1)
                    {
                        <a asp-route-buscar="@busquedaActual" asp-route-filtro="@filtroActual" asp-route-pagina="@(paginaActual - 1)">← Anterior</a>
                    }
                    <span>Página @paginaActual de @totalPaginas</span>
                    @if (paginaActual < totalPaginas)
                    {
                        <a asp-route-buscar="@busquedaActual" asp-route-filtro="@filtroActual" asp-route-pagina="@(paginaActual + 1)">Siguiente →</a>
                    }
                </nav>
            }
        }
    </section>

    <section class="notificaciones-pie">
        <span aria-hidden="true">✧</span>
        <p>
            Algunas historias llegan en forma de libro.
            Otras, en forma de mensaje.
        </p>
    </section>
</main>
