@model IReadOnlyList<Libro>
@{
    ViewData["Title"] = "Inicio";
}
<div class="home-page">
    <section class="hero-section">
        <div class="hero-content">
            <div class="book-symbol"><img class="book-icon" src="~/images/logo.png" alt="Entre Páginas" /></div>
            <h1>Entre Páginas</h1>
            <div class="ornament"><span></span><i>🪶</i><span></span></div>
            <p>Donde cada historia encuentra a su lector</p>
        </div>
        <form class="search-panel" asp-controller="Libros" asp-action="Index" method="get">
            <div class="search-row">
                <div class="search-input"><span>⌕</span><input name="buscar" type="search" placeholder="Buscar un libro, autor o tema..." aria-label="Buscar libros" /></div>
                <button class="search-button" type="submit">Buscar</button>
            </div>
            <div class="category-filters">
                <span>Explorá historias de todos los géneros</span>
                <a asp-controller="Libros" asp-action="Index">Ver todo el catálogo →</a>
            </div>
        </form>
    </section>
    <section class="books-section">
        <div class="books-container">
            <div class="section-title"><span class="line"></span><div><img class="brand-logo" src="~/images/logo.png" alt="" /><h2>Descubrí nuevas historias</h2></div><span class="line"></span></div>
            @if (Model.Count == 0)
            {
                <div class="empty-state"><h3>La biblioteca está empezando a crecer</h3><p>Cuando los escritores publiquen sus obras, vas a encontrarlas acá.</p><a class="book-button" asp-controller="Libros" asp-action="Index">Explorar catálogo</a></div>
            }
            else
            {
                <div class="books-grid">
                    @foreach (var libro in Model)
                    {
                        var portada = string.IsNullOrWhiteSpace(libro.PortadaUrl) ? Url.Content("~/images/portada1.jpg") : (libro.PortadaUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ? libro.PortadaUrl : Url.Content("~/" + libro.PortadaUrl.TrimStart('/')));
                        <article class="book-card">
                            <a asp-controller="Libros" asp-action="Detalle" asp-route-id="@libro.Id"><img src="@portada" alt="Portada de @libro.Titulo" loading="lazy" /></a>
                            <h3>@libro.Titulo</h3>
                            <p class="author">@(string.IsNullOrWhiteSpace(libro.Autor) ? $"Por {libro.Escritor.Nombre} {libro.Escritor.Apellido}" : libro.Autor)</p>
                            <span class="category">@libro.Categoria.Nombre</span>
                            <a asp-controller="Libros" asp-action="Detalle" asp-route-id="@libro.Id" class="book-button">Ver libro</a>
                        </article>
                    }
                </div>
                <div class="home-view-all"><a class="library-search-button" asp-controller="Libros" asp-action="Index">Ver catálogo completo</a></div>
            }
        </div>
    </section>
</div>
