@model int
<a class="nav-notifications-link" asp-controller="Notificaciones" asp-action="Index">
    <span>Notificaciones</span>
    @if (Model > 0)
    {
        <span class="nav-notifications-count" aria-label="@Model notificaciones sin leer">@(Model > 99 ? "99+" : Model.ToString())</span>
    }
</a>
