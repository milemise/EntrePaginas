@model EstadisticasEscritorViewModel
@{
    ViewData["Title"] = "Estadísticas de mis obras";
    var buscar = Model.Buscar ?? string.Empty;
}
<div class="management-page"><div class="management-container">
    <header class="management-header"><span class="library-small-title">ESPACIO DE ESCRITORES</span><h1>Estadísticas de tus obras</h1><p>Resumen de compras, alquileres e importes asociados a tus libros publicados.</p></header>
    <div class="admin-stat-grid">
        <article class="admin-stat-card"><span>Obras publicadas</span><strong>@Model.LibrosPublicados</strong><a asp-controller="Libros" asp-action="MisLibros">Gestionar obras →</a></article>
        <article class="admin-stat-card"><span>Compras no devueltas</span><strong>@Model.Ventas</strong><small>Operaciones registradas</small></article>
        <article class="admin-stat-card"><span>Alquileres vigentes</span><strong>@Model.Alquileres</strong><small>Alquileres activos no vencidos</small></article>
        <article class="admin-stat-card"><span>Ingresos por compras</span><strong>@Model.IngresosVentas.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</strong><small>Antes de comisiones</small></article>
        <article class="admin-stat-card"><span>Ingresos por alquiler</span><strong>@Model.IngresosAlquileres.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</strong><small>Importes de alquileres registrados</small></article>
    </div>
    <section class="management-card"><h2>Detalle por libro</h2>
        <form method="get" asp-action="Estadisticas" class="admin-search-form"><input class="form-control" type="search" name="buscar" value="@buscar" maxlength="150" placeholder="Buscar por libro, autor o categoría..." aria-label="Buscar en estadísticas de libros" /><button class="detail-secondary-button" type="submit">Buscar</button>@if (!string.IsNullOrWhiteSpace(buscar)) { <a class="detail-secondary-button" asp-action="Estadisticas">Limpiar</a> }</form>
        @if (Model.Libros.Count == 0)
        {
            <p class="muted-note">@(string.IsNullOrWhiteSpace(buscar) ? "Publicá tu primera obra para comenzar a ver estadísticas." : "No encontramos libros con esa búsqueda. Probá con otro título, autor o categoría.")</p>
        }
        else
        {
            <div class="table-responsive"><table class="table management-table"><thead><tr><th>Libro</th><th>Compras</th><th>Alquileres vigentes</th><th>Ingresos estimados</th></tr></thead><tbody>@foreach (var item in Model.Libros) { <tr><td><a asp-controller="Libros" asp-action="Detalle" asp-route-id="@item.Id">@item.Titulo</a></td><td>@item.Ventas</td><td>@item.Alquileres</td><td>@item.Ingresos.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</td></tr> }</tbody></table></div>
            @if (Model.TotalPaginas > 1) { <nav class="library-pagination" aria-label="Paginación de estadísticas">@if (Model.Pagina > 1) { <a asp-route-buscar="@buscar" asp-route-pagina="@(Model.Pagina - 1)">← Anterior</a> }<span>Página @Model.Pagina de @Model.TotalPaginas</span>@if (Model.Pagina < Model.TotalPaginas) { <a asp-route-buscar="@buscar" asp-route-pagina="@(Model.Pagina + 1)">Siguiente →</a> }</nav> }
        }
    </section>
</div></div>
